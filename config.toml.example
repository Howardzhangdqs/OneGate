bind_port = 5678
intercept_port = 0
enable_log = false
# log_format = "full"   # "full" = per-request .json with body (default), "headers" = daily .jsonl with headers only

# OpenAI-compatible /v1/* and /litellm/v1/* endpoints. They are backed by the
# litellm dependency, which costs ~200 MB of RSS and ~1.9s on first use.
# Set to false when no client needs them; the routes then answer 410 Gone
# without importing litellm. Plain proxying through a provider prefix is
# unaffected.
enable_v1 = true

# Client tool recognition is always on (no config needed): each request is
# fingerprinted by User-Agent / headers into a client name (claude-code, codex,
# opencode, zcode, cursor, ...) and recorded in client_usage_log. View the
# breakdown at /clients and per-token at /usage. This is independent of
# banned_uas below — recognized tools are NOT blocked unless matched there.

# banned_uas = ["Bun*"]  # Wildcard patterns (fnmatch) to block by User-Agent

[timeout]
total = 1800
connect = 30
sock_read = 900
# SSE stream guard: send `: ping` every stream_heartbeat seconds of upstream
# silence and close the stream after stream_idle seconds of silence.
# 0 disables either. Also settable via TIMEOUT_STREAM_HEARTBEAT / TIMEOUT_STREAM_IDLE.
# stream_heartbeat = 10.0
# stream_idle = 60.0

[compression]
# Whether to decompress response body before writing to log files.
# Supports: gzip, deflate, br (requires brotli package), zstd (requires zstandard package).
decompress_log = true

[privacy]
# Strip client-tracking identifiers before forwarding upstream:
# - tracking headers (x-session-id, x-zcode-trace-id, x-query-id, x-request-id,
#   x-title, x-os-*, x-platform, x-client-timezone/language, x-release-channel,
#   x-zcode-*, x-app, http-referer, x-stainless-*, X-Forwarded-*, X-Real-IP)
# - body fields "metadata" (Anthropic user_id device/session ids) and "user" (OpenAI)
# Client detection for usage stats is unaffected (it reads the inbound request).
strip_tracking = true
# User-Agent sent upstream when set; "" (default) keeps the client's original UA.
ua_override = ""

[pool]
count = 10
usage_db = "data/onegate.db"
# admin_tokens = []  # Auto-generated on first startup if empty
# Global default cache-token weights for TP* (tokens-per-*) accounting.
# TP usage = input + output + cache_read_weight*cache_read + cache_write_weight*cache_write.
# Per-token weights can override these (set to -1 in admin to inherit).
# cache_read_weight = 0.0
# cache_write_weight = 0.0

[providers.openai]
prefix = "/oai"
upstream = "https://api.openai.com"
strip_prefix = true
env_token = "TOKEN_OPENAI"

[providers.anthropic]
prefix = "/claude"
upstream = "https://api.anthropic.com"
strip_prefix = true
env_token = "TOKEN_ANTHROPIC"

[providers.grok]
prefix = "/grok"
upstream = "https://api.x.ai"
strip_prefix = true
env_token = "TOKEN_GROK"

[providers.litellm]
prefix = "/litellm/v1"
upstream = "https://open.bigmodel.cn/api/coding/paas/v4"
strip_prefix = true
env_token = "TOKEN_ZHIPUAI"

[providers.deepseek]
prefix = "/deepseek"
upstream = "https://api.deepseek.com"
strip_prefix = true
env_token = "TOKEN_DEEPSEEK"

# OpenAI-compatible gateways that issue distinct keys per model family:
# one provider block per key (same upstream, different env_token) so each key
# gets its own status/usage bucket. Client base_url = http://<host>:<port>/gjzq/glm
# (request /v1/chat/completions is appended, prefix is stripped before forwarding).
[providers.gjzq-glm]
prefix = "/gjzq/glm"
upstream = "https://gpt.gjzq.cn/prod-api"
strip_prefix = true
env_token = "TOKEN_GJZQ_GLM"

[providers.gjzq-deepseek]
prefix = "/gjzq/ds"
upstream = "https://gpt.gjzq.cn/prod-api"
strip_prefix = true
env_token = "TOKEN_GJZQ_DS"

[providers.default]
prefix = "/"
upstream = "https://api.openai.com"
strip_prefix = false
env_token = "TOKEN_OPENAI"

# [quota]
# Coding Plan quota card on the /usage page.
# Defaults: origin of the provider with v1_base (else the "/" provider),
# its env_token, and a 60s cache. Set explicitly to override.
# base = "https://open.bigmodel.cn"
# token = ""
# cache_ttl = 60
