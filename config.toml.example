bind_port = 5678
intercept_port = 0
enable_log = false
# log_format = "full"   # "full" = 每条请求一个含 body 的 .json（默认），"headers" = 按天一个仅含头部的 .jsonl

# /v1/* 与 /litellm/v1/* 的 chat 和 responses 端点不再提供：
# 它们需要 litellm 依赖（约 200 MB RSS）。OpenAI 兼容的
# 模型目录（/v1/models）在没有该依赖时仍然可用。使用提供商
# 前缀访问上游，例如 /<prefix>/v1/chat/completions。

# 客户端工具识别始终开启（无需配置）：每个请求都会按 User-Agent / 头部
# 指纹识别为客户端名称（claude-code、codex、opencode、zcode、cursor 等）
# 并记录到 client_usage_log。可在 /clients 查看分布，在 /usage 查看按 token
# 的明细。此功能独立于下方的 banned_uas —— 被识别的工具不会被封禁，
# 除非在那里命中匹配。

# banned_uas = ["Bun*"]  # 按 User-Agent 封禁的通配模式（fnmatch）

[timeout]
total = 1800
connect = 30
sock_read = 900
# SSE stream 保护：上游每静默 stream_heartbeat 秒发送一次 `: ping`，
# 并在静默 stream_idle 秒后关闭 stream。设为 0 可分别禁用。
# 也可通过 TIMEOUT_STREAM_HEARTBEAT / TIMEOUT_STREAM_IDLE 设置。
# stream_heartbeat = 10.0
# stream_idle = 60.0

[compression]
# 是否在写入日志文件前解压响应 body。
# 支持：gzip、deflate、br（需要 brotli 包）、zstd（需要 zstandard 包）。
decompress_log = true

[privacy]
# 转发上游前剥离客户端追踪标识：
# - 追踪头（x-session-id、x-zcode-trace-id、x-query-id、x-request-id、
#   x-title、x-os-*、x-platform、x-client-timezone/language、x-release-channel、
#   x-zcode-*、x-app、http-referer、x-stainless-*、X-Forwarded-*、X-Real-IP）
# - body 字段 "metadata"（Anthropic user_id 设备/session id）与 "user"（OpenAI）
# 用于用量统计的客户端识别不受影响（它读取的是入站请求）。
strip_tracking = true
# 设置后作为发往上游的 User-Agent；""（默认）保留客户端原始 UA。
ua_override = ""

[pool]
count = 10
usage_db = "data/onegate.db"
# admin_tokens = []  # 首次启动时若为空则自动生成
# 用于 TP*（tokens-per-*）计量的全局默认缓存 token 权重。
# TP 用量 = input + output + cache_read_weight*cache_read + cache_write_weight*cache_write。
# 按 token 的权重可覆盖这些值（在管理面板中设为 -1 表示继承）。
# cache_read_weight = 0.0
# cache_write_weight = 0.0

[providers.openai]
prefix = "/oai"
upstream = "https://api.openai.com"
strip_prefix = true
env_token = "TOKEN_OPENAI"

[providers.anthropic]
prefix = "/claude"
upstream = "https://api.anthropic.com"
strip_prefix = true
env_token = "TOKEN_ANTHROPIC"

[providers.grok]
prefix = "/grok"
upstream = "https://api.x.ai"
strip_prefix = true
env_token = "TOKEN_GROK"

[providers.deepseek]
prefix = "/deepseek"
upstream = "https://api.deepseek.com"
strip_prefix = true
env_token = "TOKEN_DEEPSEEK"

# 按模型系列签发不同 key 的 OpenAI 兼容网关：
# 每把 key 一个提供商块（相同 upstream，不同 env_token），使每把 key
# 拥有各自的 status/usage 分桶。客户端 base_url = http://<host>:<port>/gjzq/glm
# （请求 /v1/chat/completions 会追加到其后，转发前会去掉前缀）。
[providers.gjzq-glm]
prefix = "/gjzq/glm"
upstream = "https://gpt.gjzq.cn/prod-api"
strip_prefix = true
env_token = "TOKEN_GJZQ_GLM"

[providers.gjzq-deepseek]
prefix = "/gjzq/ds"
upstream = "https://gpt.gjzq.cn/prod-api"
strip_prefix = true
env_token = "TOKEN_GJZQ_DS"

[providers.default]
prefix = "/"
upstream = "https://api.openai.com"
strip_prefix = false
env_token = "TOKEN_OPENAI"

# [quota]
# /usage 页面上的 Coding Plan 配额卡片。
# 默认值：带 v1_base 的提供商的 origin（否则为 "/" 提供商）、
# 其 env_token，以及 60s 缓存。显式设置可覆盖。
# base = "https://open.bigmodel.cn"
# token = ""
# cache_ttl = 60
